{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offering",
    "free_messages"
  ],
  "properties": {
    "offering": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
    },
    "free_messages": {
      "type": "boolean"
    }
  }
}
