{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canal-questoes.invalid/contracts/api/v1/schemas/students.summary.response.schema.json",
  "title": "GET /v1/offerings/{ref}/students/summary — 200",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offering",
    "enrolled",
    "no_invite",
    "sending",
    "invite_valid",
    "terms_presented",
    "invite_lapsed",
    "send_failed",
    "linked"
  ],
  "properties": {
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering_id",
        "code"
      ],
      "properties": {
        "offering_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
        }
      }
    },
    "enrolled": {
      "type": "integer",
      "minimum": 0
    },
    "no_invite": {
      "type": "integer",
      "minimum": 0
    },
    "sending": {
      "type": "integer",
      "minimum": 0
    },
    "invite_valid": {
      "type": "integer",
      "minimum": 0
    },
    "terms_presented": {
      "type": "integer",
      "minimum": 0
    },
    "invite_lapsed": {
      "type": "integer",
      "minimum": 0
    },
    "send_failed": {
      "type": "integer",
      "minimum": 0
    },
    "linked": {
      "type": "integer",
      "minimum": 0
    }
  }
}
