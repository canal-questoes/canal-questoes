{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canal-questoes.invalid/contracts/api/v1/schemas/students.import.request.schema.json",
  "title": "POST /v1/offerings/{ref}/students — pedido",
