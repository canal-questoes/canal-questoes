      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ra",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "x-identity": "name"
          },
          "ra": {
            "type": "string",
            "x-identity": "ra"
          },
          "email": {
            "type": "string",
            "x-identity": "email"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    }
  }
}
