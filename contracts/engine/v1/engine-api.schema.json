{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canal-questoes/contracts/engine/v1/engine-api.schema.json",
  "title": "API HTTP interna do engine, versão 1.0",
  "description": "Pedidos e respostas das operações do motor. Rotas: GET /v1/health, POST /v1/inspect, POST /v1/variants, POST /v1/grade. Resultados semânticos (suportada, não suportada, quebrada) voltam com HTTP 200 e o campo outcome; falhas do pedido voltam com o objeto error e o status HTTP correspondente. Só 5xx deve ser tratado pelo núcleo como passível de nova tentativa.",
  "$defs": {
    "question_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "commit",
        "qid"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Identificador opaco do repositório (tipicamente a URL git). A raiz do curso é <ENGINE_REPOS_ROOT>/<sha256_hex(repo em UTF-8)>/<commit>/."
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "qid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        }
      }
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-z]{1,7}$",
      "description": "Seed no formato do PL: inteiro em base 36, minúsculo, com valor em [0, 2^32). O limite superior é conferido pelo engine."
    },
    "json_object": {
      "type": [
        "object",
        "array"
      ],
      "description": "Como no checkData do PL, que aceita qualquer valor não nulo com typeof 'object' (inclusive listas)."
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "console_output",
            "missing_media",
            "media_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "generate",
            "prepare",
            "render",
            "file",
            "parse",
            "grade"
          ]
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "question_type_not_v3",
            "grading_method_not_internal",
            "external_grading",
            "workspace",
            "unsupported_elements",
            "no_answer_fields",
            "course_element_override",
            "custom_server_render",
            "invalid_answers_name",
            "invalid_question_metadata"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Frase funcional em português."
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "broken_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "phase"
      ],
      "properties": {
        "code": {
          "enum": [
            "question_code_error",
            "timeout",
            "invalid_data",
            "ir_contract_violation"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Frase funcional em português, sem detalhe técnico."
        },
        "phase": {
          "enum": [
            "generate",
            "prepare",
            "render",
            "file",
            "parse",
            "grade"
          ]
        },
        "technical_detail": {
          "type": "string",
          "maxLength": 8000,
          "description": "Mensagem, traceback e saída do Python, truncados; nunca os dados da chamada (respostas cruas). Nunca vai para os registros do motor: nas fases parse e grade, o que a questão imprime pode citar a resposta do aluno."
        }
      }
    },
    "question_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "title",
        "topic",
        "tags",
        "type",
        "grading_method",
        "elements",
        "show_correct_answer",
        "single_variant",
        "partial_credit",
        "answers_names",
        "content_hash"
      ],
      "properties": {
        "uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "grading_method": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": "Nomes canônicos (os do mapa de elementos do PL: core e curso) das tags de elemento usadas, em ordem alfabética."
        },
        "show_correct_answer": {
          "type": "boolean"
        },
        "single_variant": {
          "type": "boolean"
        },
        "partial_credit": {
          "type": "boolean"
        },
        "answers_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "params",
        "correct_answers",
        "preferences",
        "engine_version",
        "pl_commit",
        "ir_version"
      ],
      "properties": {
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "params": {
          "$ref": "#/$defs/json_object"
        },
        "correct_answers": {
          "$ref": "#/$defs/json_object"
        },
        "preferences": {
          "$ref": "#/$defs/json_object"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "pl_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ir_version": {
          "const": "1.0"
        }
      }
    },
    "format_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html",
        "text"
      ],
      "properties": {
        "html": {
          "type": "string",
          "description": "Mensagem do PL, como o PL a produziu."
        },
        "text": {
          "type": "string",
          "description": "A mesma mensagem em texto simples."
        }
      }
    },
    "health_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "engine_version",
        "contract_version",
        "ir_version",
        "pl_commit",
        "workers"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "contract_version": {
          "const": "1.0"
        },
        "ir_version": {
          "const": "1.0"
        },
        "pl_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inspect_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_ref"
      ],
      "properties": {
        "question_ref": {
          "$ref": "#/$defs/question_ref"
        }
      }
    },
    "inspect_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "question",
        "reasons"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "question": {
          "$ref": "#/$defs/question_metadata"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "supported"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "create_variant_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_ref",
        "seed"
      ],
      "properties": {
        "question_ref": {
          "$ref": "#/$defs/question_ref"
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "preferences": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "create_variant_response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "snapshot",
            "ir",
            "warnings"
          ],
          "properties": {
            "outcome": {
              "const": "ok"
            },
            "snapshot": {
              "$ref": "#/$defs/snapshot"
            },
            "ir": {
              "$ref": "ir.schema.json"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/warning"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "reason",
            "warnings"
          ],
          "properties": {
            "outcome": {
              "const": "broken"
            },
            "reason": {
              "$ref": "#/$defs/broken_reason"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/warning"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "reasons"
          ],
          "properties": {
            "outcome": {
              "const": "unsupported"
            },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/reason"
              }
            }
          }
        }
      ]
    },
    "grade_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_ref",
        "snapshot",
        "raw_submitted_answers"
      ],
      "properties": {
        "question_ref": {
          "$ref": "#/$defs/question_ref"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot_input"
        },
        "raw_submitted_answers": {
          "type": "object",
          "description": "Resposta crua por answers-name, sem normalização: string, lista de strings (escolha múltipla com várias marcações) ou o valor que o PL gravaria."
        }
      }
    },
    "grade_response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "valid",
            "format_errors",
            "submitted_answers",
            "partial_scores",
            "score",
            "feedback",
            "params",
            "correct_answers",
            "version_mismatch",
            "warnings"
          ],
          "properties": {
            "outcome": {
              "const": "ok"
            },
            "valid": {
              "type": "boolean"
            },
            "format_errors": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/format_error"
              }
            },
            "submitted_answers": {
              "$ref": "#/$defs/json_object"
            },
            "partial_scores": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": [
                    "object",
                    "array"
                  ]
                }
              ]
            },
            "score": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ],
              "description": "A nota como o PL a calcula (normalmente entre 0 e 1; o grade() do código da questão pode definir outro valor finito, e o motor o repassa)."
            },
            "feedback": {
              "$ref": "#/$defs/json_object"
            },
            "params": {
              "$ref": "#/$defs/json_object"
            },
            "correct_answers": {
              "$ref": "#/$defs/json_object"
            },
            "version_mismatch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "pl"
              ],
              "properties": {
                "engine": {
                  "type": "boolean"
                },
                "pl": {
                  "type": "boolean"
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/warning"
              }
            }
          },
          "if": {
            "type": "object",
            "properties": {
              "valid": {
                "const": false
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "score": {
                "type": "null"
              },
              "partial_scores": {
                "type": "null"
              },
              "format_errors": {
                "type": "object",
                "minProperties": 1
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "partial_scores": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "format_errors": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "reason",
            "version_mismatch",
            "warnings"
          ],
          "properties": {
            "outcome": {
              "const": "broken"
            },
            "reason": {
              "$ref": "#/$defs/broken_reason"
            },
            "version_mismatch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "pl"
              ],
              "properties": {
                "engine": {
                  "type": "boolean"
                },
                "pl": {
                  "type": "boolean"
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/warning"
              }
            }
          }
        }
      ]
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "not_found",
                "payload_too_large",
                "route_not_found",
                "method_not_allowed",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "snapshot_input": {
      "type": "object",
      "additionalProperties": true,
      "description": "Snapshot recebido na correção: tolerante a versões compatíveis e a chaves desconhecidas de motores mais novos.",
      "required": [
        "seed",
        "params",
        "correct_answers",
        "preferences",
        "engine_version",
        "pl_commit",
        "ir_version"
      ],
      "properties": {
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "params": {
          "$ref": "#/$defs/json_object"
        },
        "correct_answers": {
          "$ref": "#/$defs/json_object"
        },
        "preferences": {
          "$ref": "#/$defs/json_object"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "pl_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ir_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        }
      }
    }
  }
}
