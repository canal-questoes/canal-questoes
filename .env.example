# Modelo das variáveis do compose.yaml (ver o cabeçalho dele). Nunca coloque valores
# reais neste arquivo: ele é versionado. O .env de verdade fica fora do git (.gitignore).
#
# Senha do usuário `cq` do Postgres (obrigatória). Ela entra na URL do banco, então use só
# caracteres seguros em URL, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
CQ_DB_PASSWORD=<senha do banco>

# Token inicial de administração (opcional; se definido, com pelo menos 32 caracteres), por exemplo:
#   python -c "import secrets; print('cq_' + secrets.token_urlsafe(32))"
CQ_ADMIN_TOKEN=<token inicial>

# Porta da API no host, publicada só em 127.0.0.1 (opcional; padrão 8000).
CQ_API_PORT=
