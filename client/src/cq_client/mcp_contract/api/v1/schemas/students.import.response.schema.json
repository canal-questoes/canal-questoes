{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canal-questoes.invalid/contracts/api/v1/schemas/students.import.response.schema.json",
  "title": "POST /v1/offerings/{ref}/students — 200",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offering",
    "received",
    "people_created",
    "people_reused",
    "enrollments_created",
    "already_enrolled"
  ],
  "properties": {
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering_id",
        "code"
      ],
      "properties": {
        "offering_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
        }
      }
    },
    "received": {
      "type": "integer",
      "minimum": 0
    },
    "people_created": {
      "type": "integer",
      "minimum": 0
    },
    "people_reused": {
      "type": "integer",
      "minimum": 0
    },
    "enrollments_created": {
      "type": "integer",
      "minimum": 0
    },
    "already_enrolled": {
      "type": "integer",
      "minimum": 0
    }
  }
}
