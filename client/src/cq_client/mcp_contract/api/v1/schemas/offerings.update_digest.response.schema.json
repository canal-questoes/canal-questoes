{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canal-questoes.invalid/contracts/api/v1/schemas/offerings.update_digest.response.schema.json",
  "title": "PATCH /v1/offerings/{ref}/digest — 200",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offering",
    "timezone",
    "enabled",
    "local_time"
  ],
  "properties": {
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering_id",
        "code"
      ],
      "properties": {
        "offering_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
        }
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "enabled": {
      "type": "boolean"
    },
    "local_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
