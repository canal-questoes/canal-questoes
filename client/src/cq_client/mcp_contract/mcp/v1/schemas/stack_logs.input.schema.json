{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "api",
          "worker",
          "postgres"
        ]
      }
    },
    "tail": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  }
}
