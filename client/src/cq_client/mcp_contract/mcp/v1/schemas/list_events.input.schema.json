{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
      }
    },
    "person": {
      "type": "string",
      "pattern": "^(?:(?=[0-9a-f]*[a-f])[0-9a-f]{4,32}|[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
    },
    "after": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  }
}
