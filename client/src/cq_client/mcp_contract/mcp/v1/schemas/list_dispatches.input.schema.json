{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offering"
  ],
  "properties": {
    "offering": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
    },
    "after": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  }
}
